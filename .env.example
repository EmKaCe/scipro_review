# ─── Shared ─────────────────────────────────────────────
# Docker Compose project name
COMPOSE_PROJECT_NAME=svelte-review

# ─── SvelteKit Frontend ─────────────────────────────────
ADAPTER=node
PORT=4174
# How the frontend reaches the executor (container hostname)
EXECUTOR_URL=http://executor:8766
# Node environment
NODE_ENV=production
# Public origin teachers use to reach the app. Required for form POSTs
# (uploads, materials) to pass the CSRF check over plain HTTP — without it
# adapter-node assumes https and rejects them. Example: http://192.168.1.10:4174
ORIGIN=http://localhost:4174

# ─── Python Executor ─────────────────────────────────────
# Internal port for the FastAPI server
EXECUTOR_PORT=8766
# Log level (debug / info / warning / error)
EXECUTOR_LOG_LEVEL=info

# ─── Rich notebook outputs (B11) ─────────────────────────
# The teacher preview renders rich cell outputs (matplotlib plots as
# image/png, pandas displays as text/html) alongside the plain text. These
# caps bound how much a single student cell can add to the stored
# results.json. Defaults: 5 MiB per image and 200k chars of HTML.
#   - Images over RICH_OUTPUT_MAX_IMAGE_BYTES are SKIPPED (logged).
#   - HTML over RICH_OUTPUT_MAX_HTML_CHARS is truncated.
# Rich output is rendered in a SANDBOXED iframe (script-less, opaque origin)
# and never included in LLM prompts (prompts stay text-only).
RICH_OUTPUT_MAX_IMAGE_BYTES=5242880
RICH_OUTPUT_MAX_HTML_CHARS=200000

# ─── LLM: KI Connect NRW (default) ──────────────────────
# Base URL for the KI Connect NRW OpenAI-compatible API.
# ANY OpenAI-compatible base URL works here — KI Connect is just the default.
# To use another provider (e.g. OpenRouter), uncomment the block at the bottom
# of this section and set the three KI_CONNECT_* vars to that provider.
KI_CONNECT_BASE_URL=https://chat.kiconnect.nrw/api/v1
# Bearer token for KI Connect NRW authentication.
# Set it here (env) or at runtime under Settings → Execution & AI — never
# write it into data/settings.yaml (it is never committed).
KI_CONNECT_API_KEY=
# Default LLM model id (env fallback for llm.model).
KI_CONNECT_MODEL=qwen3-30b-a3b-instruct-2507
# LLM request timeout in ms (env fallback for llm.timeout_ms).
KI_CONNECT_TIMEOUT_MS=60000
#
# --- Optional: switch to any OpenAI-compatible provider (e.g. OpenRouter) ---
# The docs-RAG embedder uses the SAME provider via the AI SDK, with embedder
# model e5-mistral-7b-instruct. It must keep the 4096-dimension contract of
# docs-vectors.bin, or vector search degrades to BM25-only (the loader never
# throws). Pick the model id from the provider's model list (placeholder below).
# The key is runtime-only (Settings → Execution and AI) or env — never committed.
#   # KI_CONNECT_BASE_URL=https://openrouter.ai/api/v1
#   # KI_CONNECT_API_KEY=sk-or-...
#   # KI_CONNECT_MODEL=<model-id>

# ─── Phase 4: LLM API Keys ──────────────────────────────
# Uncomment and fill in when integrating additional LLM features
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

{
	"name": "frontend",
	"private": true,
	"version": "2.5.1",
	"license": "AGPL-3.0",
	"type": "module",
	"scripts": {
		"dev": "echo 'Specify mode: pnpm run dev:student (GitHub Pages) or dev:teacher (Docker)' && false",
		"dev:student": "cp -r ../data static/ && vite dev",
		"dev:teacher": "cp -r ../data static/ && ADAPTER=node vite dev",
		"start:teacher": "rm -rf build && pnpm build:teacher && PORT=4174 node build/index.js",
		"start:student": "rm -rf build && pnpm build:student && python3 -m http.server 4173 -d build",
		"build": "echo 'Specify mode: pnpm run build:student (GitHub Pages) or build:teacher (Docker)' && false",
		"build:student": "vite build",
		"build:teacher": "ADAPTER=node vite build",
		"preview:student": "vite preview",
		"preview:teacher": "ADAPTER=node vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prebuild": "cp -r ../data static/"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@lucide/svelte": "^1.27.0",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.1.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.8.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.12",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.32",
		"@mastra/core": "^1.60.0",
		"@mastra/memory": "^1.27.0",
		"@tiptap/core": "^3.30.2",
		"@tiptap/extension-placeholder": "^3.30.2",
		"@tiptap/starter-kit": "^3.30.2",
		"fflate": "^0.8.3",
		"highlight.js": "^11.12.0",
		"idb": "^8.0.3",
		"js-yaml": "^5.3.0",
		"katex": "^0.18.4",
		"marked": "^18.0.10",
		"minisearch": "^7.2.0",
		"pdf-parse": "1.1.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	}
}

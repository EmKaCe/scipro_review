reviews/**
# Student submissions — never committed
data/submissions/

# Plagiarism results cache (per-assignment runtime state) — never committed
data/plagiarism/

# Copilot audit log (append-only JSONL runtime trail) — never committed
data/copilot/

# Assignment materials — keys, PDFs, input data — never committed
data/materials/

# Exception: criteria, grading config, and registry stay in git
!data/assignments.yaml
!data/grading_config.yaml
!data/criteria/

# Grading analysis artifacts (student grades) — never committed
grading-output/

# Hermes agent config (keep local)
.hermes/*
!.hermes/plans/
!.hermes/plans/**

# Environment variables — secrets
.env

# Python virtual environment (local dev only)
executor/.venv/
__pycache__/
executor/*.egg-info/

# Python lockfile (uv) — committed for reproducibility
executor/uv.lock

# Docs (research artifacts, not code) — but keep tracked directives
docs/*
!docs/directives/

# Hermes agent plans (local session planning only)
.hermes/
